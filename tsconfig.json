{
  // Tanda 29: TypeScript gradual. strict aplica a los .ts; los .js/.jsx
  // conviven sin chequeo (allowJs + checkJs:false) y se migran por
  // etapas empezando por la lógica pura (src/data/*Logic).
  // Verificar con: npm run typecheck
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
